<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="Smoke Tests API v1" verbose="1" parallel="methods" thread-count="2">
    <parameter name="env" value="prod" />
    <test name="Smoke Tests">

        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
            <class name="api.tests.UsersTests"/>

        </classes>
    </test>
</suite>

